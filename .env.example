# Never put secrets in VITE_ variables. Configure these in Vercel's server environment.
PUBLIC_SITE_URL=https://london-tech.vercel.app
# Hosted PostgreSQL connection string. Local development uses .data/postgres when omitted.
DATABASE_URL=
# Optional session-mode PostgreSQL URL for schema initialization/migrations.
DIRECT_URL=
# Configure the first administrator before running npm run db:setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Google and Facebook web application credentials. Keep secrets server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Flutterwave v3 keys. Use a test key first, then switch to the live merchant key.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Transactional email for codes, password resets and order updates.
# Choose gmail for the current store mailbox, or resend for a verified domain.
EMAIL_PROVIDER=gmail
GMAIL_USER=
# Generate in Google Account > App passwords after enabling 2-Step Verification.
# Use a dedicated app password, not the mailbox's regular password.
GMAIL_APP_PASSWORD=
# Optional domain-based sender alternative.
RESEND_API_KEY=
EMAIL_FROM=
# Private bearer token for the daily failed-order-email retry job.
CRON_SECRET=
